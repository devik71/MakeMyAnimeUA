# 🔐 Конфігураційний файл для MakeMyAnimeUA
# Скопіюйте цей файл як .env та заповніть необхідні значення

# ========================================
# 🔑 API КЛЮЧІ
# ========================================

# DeepL API ключ (опціонально)
# Отримати можна на: https://www.deepl.com/pro-api
# Формат: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
DEEPL_API_KEY=

# HuggingFace токен (опціонально, для приватних моделей)
# Отримати можна на: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# ========================================
# 🔒 БЕЗПЕКА
# ========================================

# Flask secret key (ОБОВ'ЯЗКОВО для продакшену!)
# Згенеруйте безпечний ключ: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ========================================
# 🌐 ВЕБ-СЕРВЕР
# ========================================

# Режим налагодження (True/False)
DEBUG=False

# Хост сервера (127.0.0.1 для локального доступу, 0.0.0.0 для зовнішнього)
HOST=127.0.0.1

# Порт сервера
PORT=5001

# Максимальний розмір файлу в байтах (за замовчуванням 2GB)
MAX_FILE_SIZE=2147483648

# ========================================
# 📁 ПАПКИ
# ========================================

# Папка для завантажених файлів
UPLOAD_FOLDER=uploads

# Папка для вихідних файлів
OUTPUT_FOLDER=output

# Папка для тимчасових аудіо файлів
TEMP_AUDIO_FOLDER=temp_audio

# ========================================
# 🧠 WHISPER НАЛАШТУВАННЯ
# ========================================

# Модель Whisper за замовчуванням (tiny, base, small, medium, large)
WHISPER_DEFAULT_MODEL=base

# Використовувати GPU якщо доступно (True/False)
WHISPER_USE_GPU=True

# Пристрій для Whisper (auto, cpu, cuda)
WHISPER_DEVICE=auto

# ========================================
# 🌍 ПЕРЕКЛАД НАЛАШТУВАННЯ
# ========================================

# Движок перекладу за замовчуванням (helsinki, deepl, auto)
TRANSLATION_ENGINE=auto

# Вихідна мова за замовчуванням
SOURCE_LANGUAGE=ru

# Цільова мова за замовчуванням
TARGET_LANGUAGE=uk

# Розмір батчу для перекладу
TRANSLATION_BATCH_SIZE=10

# ========================================
# 📝 ПРИКЛАДИ НАЛАШТУВАНЬ
# ========================================

# Приклад для розробки:
# DEBUG=True
# HOST=127.0.0.1
# PORT=5001

# Приклад для продакшену:
# DEBUG=False
# HOST=0.0.0.0
# PORT=80
# FLASK_SECRET_KEY=your_very_secure_random_key_here

# Приклад з DeepL:
# DEEPL_API_KEY=12345678-1234-1234-1234-123456789012:fx
# TRANSLATION_ENGINE=deepl